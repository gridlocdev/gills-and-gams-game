<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FishLegs</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Gills &amp; Gams</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets/input-prompts/**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets/input-prompts" />
  </ItemGroup>

</Project>
